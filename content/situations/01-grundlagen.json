      "id": "d-primer-saludo",
      "kind": "dialog",
      "title": "Ein erstes Hallo",
      "lines": [
        { "speaker": "A", "es": "Hola, buenos días.", "de": "Hallo, guten Morgen." },
        { "speaker": "B", "es": "Buenos días. ¿Cómo estás?", "de": "Guten Morgen. Wie geht es dir?" },
        { "speaker": "A", "es": "Bien, gracias. Mucho gusto.", "de": "Gut, danke. Freut mich." },
        { "speaker": "B", "es": "Mucho gusto. Chao.", "de": "Freut mich. Tschüss." }
      ]
    },
    {
      "id": "g-tu-usted",
      "kind": "grammar",
      "title": "tú und usted",
      "explanation": "Unter Freunden und Gleichaltrigen sagst du tú: ¿Cómo estás? Gegenüber Älteren, Fremden und im Amt sagst du usted: ¿Cómo está usted? Die Verbform von usted ist dieselbe wie bei él und ella. In der Mehrzahl gibt es in Lateinamerika nur ustedes, für Freunde wie für Fremde. Ein eigenes Wort für euch wie in Spanien brauchst du nicht.",
      "examples": [
        { "es": "¿Cómo estás?", "de": "Wie geht es dir?" },
        { "es": "¿Cómo está usted?", "de": "Wie geht es Ihnen?" },
        { "es": "¿Cómo están ustedes?", "de": "Wie geht es euch? Oder: Wie geht es Ihnen (Mehrzahl)?" }
      ],
      "exercises": [
        { "de": "Wie geht es dir?", "es": "¿Cómo estás?", "accept": ["Cómo estás"] },
        { "de": "Wie geht es Ihnen?", "es": "¿Cómo está usted?", "accept": ["¿Cómo está?"] }
      ]
    },
